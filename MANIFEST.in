include CHANGELOG.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml
recursive-include src/repokeeper/templates/workflows *.yml

prune .github
prune build
prune dist
prune docs
prune site
prune tests

exclude AGENTS.md
exclude .gitignore
exclude cliff.toml
exclude CONTRIBUTING.md
exclude coverage.xml
exclude mkdocs.yml
exclude repokeeper.yml
exclude uv.lock
global-exclude *.py[cod]
global-exclude __pycache__
